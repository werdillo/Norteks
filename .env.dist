# Copy to .env. The value is read at build time and written into the static files.
# The browser fetches PocketBase from this address: allow the site's origin in CORS, or
# proxy /api/ through the site (see deploy/nginx.conf).
PUBLIC_POCKETBASE_URL=

# The search engines' site verification codes (public: they are written into every page; empty = no meta tag).
PUBLIC_YANDEX_VERIFICATION=5a841e308860c038
PUBLIC_GOOGLE_SITE_VERIFICATION=L0CzHxHUf0YZId7mBrEkpqS_NXfhYVEyuy8Qb-TFEzo
