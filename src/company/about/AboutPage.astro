---
import { Image } from "astro:assets";
import { Container } from "#/components/container";
import interior1 from "./assets/img6.jpg";
import interior2 from "./assets/img5.jpg";
import { aboutLead, aboutParagraphs } from "./data";

const picture = "h-auto w-full elevation-image";
---

<div class="mx-10 bg-surface">
  <h1 class="mb-16 text-48 max-768:text-40 font-bold text-gold">Нортекс</h1>
  <p class="text-24 max-768:text-19-2 text-muted">Оптовый поставщик декоративных тканей</p>
  <Container width="min">
    <div class="grid grid-cols-[1fr_1fr] gap-40 [align-items:start] max-768:grid-cols-[1fr]">
      <div class="flex flex-col gap-24 max-768:gap-14">
        <p class="my-4 text-19-2 max-768:text-17-6 leading-[1.6] text-heading">{aboutLead}</p>
        {
          aboutParagraphs.map((paragraph) => (
            <div class="text-16 leading-[1.7] text-copy">
              <p>{paragraph}</p>
            </div>
          ))
        }
      </div>

      <div class="grid gap-20">
        <Image class={picture} src={interior1} alt="Интерьер с текстилем" />
        <Image class={picture} src={interior2} alt="Дизайн интерьера" />
      </div>
    </div>
  </Container>
</div>
