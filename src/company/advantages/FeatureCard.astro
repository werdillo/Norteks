---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Card } from "#/components/card";

interface Props {
  icon: ImageMetadata;
  title: string;
  text: string;
}

const { icon, title, text } = Astro.props;
---

<Card variant="raised" class="max-w-[400px] text-center [transition:transform_0.3s_ease] hover:[transform:translateY(-5px)]">
  <div class="mb-20 text-40 text-gold">
    <Image src={icon} alt={title} width="40" height="40" />
  </div>
  <h3 class="mb-15 text-19-2 text-heading">{title}</h3>
  <p class="leading-[1.6] text-muted">{text}</p>
</Card>
