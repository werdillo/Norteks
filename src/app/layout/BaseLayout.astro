---
import Header from "../frame/Header.astro";
import Footer from "../frame/Footer.astro";
import MobileMenu from "../frame/MobileMenu.astro";
import { address, emails, phones } from "#/site/contacts";
import { jsonLd } from "#/core/seo/jsonld";
import "../styles/tokens.css";
import "../styles/main.css";
import "../styles/animations.css";

export interface Props {
  title: string;
  description: string;
  /** Path of the page the metadata is about. The default is the page itself. */
  canonical?: string;
  /** Picture of the page for social cards, a path on the site. */
  ogImage?: string;
  /** `noindex` on the fallback pages. */
  robots?: string;
  /** The Open Graph kind: a blog post is an `article`. */
  ogType?: "website" | "article";
  /** When an article was published, ISO 8601. Written only with `ogType` `article`. */
  publishedTime?: string;
  /** When an article was last changed, ISO 8601. Written only with `ogType` `article`. */
  modifiedTime?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = "/logo.png",
  robots = "index, follow",
  ogType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;
const url = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
const image = new URL(ogImage, Astro.site).href;
const isArticle = ogType === "article";
// The site's home address (with its trailing slash) and the organization's id in the graph.
const home = new URL("/", Astro.site).href;
const organizationId = `${home}#organization`;
const logo = new URL("/logo.png", Astro.site).href;
// Search engines' site verification codes, when the build has them (see .env.dist).
const yandexVerification = import.meta.env.PUBLIC_YANDEX_VERIFICATION;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Нортекс" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={url} />
    <link rel="sitemap" href="/sitemap.xml" />
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Нортекс" />
    <meta property="og:locale" content="ru_RU" />
    {isArticle && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {isArticle && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script
      type="application/ld+json"
      set:html={jsonLd({
        "@id": organizationId,
        "@type": "LocalBusiness",
        name: "Нортекс",
        description: "Оптовый поставщик декоративных тканей",
        url: home,
        logo,
        image: logo,
        telephone: phones[0]?.number,
        contactPoint: {
          "@type": "ContactPoint",
          telephone: phones[0]?.number ?? "",
          contactType: "customer service",
          areaServed: "RU",
          availableLanguage: "Russian",
        },
        address: {
          "@type": "PostalAddress",
          streetAddress: address.lines.join(", "),
          addressLocality: address.city,
          postalCode: address.postalCode,
          addressCountry: "RU",
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: address.geo.latitude,
          longitude: address.geo.longitude,
        },
        email: emails[0],
        sameAs: ["https://www.instagram.com/tknortex/", "https://t.me/tknortex"],
      })}
    />
    {
      Astro.url.pathname === "/" && (
        <script
          type="application/ld+json"
          set:html={jsonLd({
            "@type": "WebSite",
            name: "Нортекс",
            url: home,
            inLanguage: "ru",
            publisher: { "@id": organizationId },
          })}
        />
      )
    }
  </head>
  <body class="m-0 font-body">
    <div id="main" class="flex min-h-screen flex-col">
      <Header />
      <main id="content" class="mt-header max-768:mt-header-mobile flex flex-1 flex-col items-center">
        <slot />
      </main>
      <MobileMenu />
      <Footer />
    </div>
  </body>
</html>
