---
import { socialLinks } from "../social";
---

<div class="flex gap-24 max-1400:gap-20 max-1200:gap-16 max-768:hidden">
  {
    socialLinks.map((social) => (
      <a href={social.href} aria-label={social.alt} rel={social.href.startsWith("http") ? "noopener" : undefined}>
        <span
          class:list={[social.icon, "block h-24 w-24 cursor-pointer max-1200:h-22 max-1200:w-22 max-768:h-20 max-768:w-20"]}
          aria-hidden="true"
        />
      </a>
    ))
  }
</div>
