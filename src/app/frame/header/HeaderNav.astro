---
import { P3 } from "#/components/typography";
import { headerNav, isCurrent } from "../navigation";

const path = Astro.url.pathname;
const base = "hover:text-highlight";
const current = "text-highlight";
---

<nav aria-label="Разделы" class="flex flex-wrap gap-30 max-1600:gap-25 max-1400:gap-20 max-1200:hidden">
  {
    headerNav.map((item) => {
      const now = isCurrent(item, path);
      return (
        <P3 as="a" href={item.href} aria-current={now ? "page" : undefined} class={now ? `${base} ${current}` : `${base} text-on-dark`}>
          {item.text}
        </P3>
      );
    })
  }
</nav>
<div class="min-1200:hidden max-385:hidden">
  <P3
    as="a"
    href="/contacts/"
    aria-current={path.includes("/contacts") ? "page" : undefined}
    class={path.includes("/contacts") ? "hover:text-highlight text-highlight" : "hover:text-highlight text-on-dark"}
  >
    Контакты
  </P3>
</div>
