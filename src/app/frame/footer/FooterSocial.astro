---
import { socialLinks } from "../social";

// Only the accounts that have a page: a "#" link would lead nowhere.
const links = socialLinks.filter((social) => social.href !== "#");
const circle =
  "flex h-38 w-38 items-center justify-center rounded-[50%] text-on-dark [border:1px_solid_var(--color-on-dark-faint)] bg-on-dark-faint [transition:all_0.25s] hover:border-highlight hover:text-highlight hover:[transform:translateY(-2px)]";
---

<div class="flex items-center gap-12">
  {
    links.map((social) => (
      <a href={social.href} class={circle} aria-label={social.alt} rel="noopener" target="_blank">
        <span class:list={[social.icon, "h-18 w-18"]} aria-hidden="true" />
      </a>
    ))
  }
</div>
