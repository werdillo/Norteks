---
import { Image } from "astro:assets";
import { P1, P3 } from "#/components/typography";
import location from "../../assets/icons/location.svg";
---

<div class="relative ml-26 flex flex-col gap-6 max-768:mt-12">
  <Image class="absolute top-[-20px] left-[-24px]" src={location} alt="" />
  <P3 as="div" class="text-on-dark">Москва</P3>
  <P1 as="div" class="text-on-dark">Дмитровское шоссе 71Б</P1>
  <P1 as="div" class="text-on-dark">Бизнес-центр 7ONE, ООО "Нортекс"</P1>
</div>
