---
import { P1, P3 } from "#/components/typography";
import { address } from "#/site/contacts";
---

<div class="relative ml-26 flex flex-col gap-6 max-768:mt-12">
  <span class="i-tabler-map-pin absolute top-[-20px] left-[-24px] h-24 w-24" aria-hidden="true" />
  <P3 as="div" class="text-on-dark">{address.city}</P3>
  {address.lines.map((line) => <P1 as="div" class="text-on-dark">{line}</P1>) }
</div>
