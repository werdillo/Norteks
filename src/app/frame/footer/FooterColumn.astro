---
import { P3 } from "#/components/typography";

interface Props {
  /** The small gold label over the column. */
  title: string;
}

const { title } = Astro.props;
---

<div class="flex flex-col gap-18">
  <P3 as="div" class="uppercase tracking-[1.5px] text-highlight">{title}</P3>
  <slot />
</div>
