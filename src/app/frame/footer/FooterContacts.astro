---
import { P1 } from "#/components/typography";

interface Props {
  /** A phone or an e-mail, which sets the icon and its size. */
  variant: "phone" | "email";
  items: { href: string; text: string }[];
}

const { variant, items } = Astro.props;

const icon = {
  phone: "i-tabler-phone h-18 w-18",
  email: "i-tabler-mail h-22 w-22",
}[variant];
---

<div class="flex items-center gap-16">
  <span class={icon} aria-hidden="true" />
  <div class="flex flex-col gap-10">
    {
      items.map((item) => (
        <P1 as="a" class="text-on-dark hover:text-highlight-soft" href={item.href}>
          {item.text}
        </P1>
      ))
    }
  </div>
</div>
