---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  icon: ImageMetadata;
  /** A phone or an e-mail, which sets the icon size. */
  variant: "phone" | "email";
  items: { href: string; text: string }[];
}

const { icon, variant, items } = Astro.props;

const iconClass = { phone: "h-auto w-18", email: "h-22 w-auto" };
---

<div class="flex items-center gap-16">
  <Image class={iconClass[variant]} src={icon} alt="" />
  <div class="flex flex-col gap-10">
    {
      items.map((item) => (
        <a
          class="text-20 max-768:text-17 text-on-dark hover:text-highlight-soft"
          href={item.href}
        >
          {item.text}
        </a>
      ))
    }
  </div>
</div>
