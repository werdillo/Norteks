---
import BaseLayout from "#/app/layout/BaseLayout.astro";
import { ContactsPage } from "#/site/contacts";
import { socialLinks } from "#/app/frame/social";

// The accounts that have a page yet ("#" is a placeholder): the contacts page links them as messengers.
const socials = socialLinks.filter((social) => social.href !== "#");

const seoData = {
  title: "Контакты компании Нортекс | Свяжитесь с поставщиком тканей",
  description: "Контактная информация компании Нортекс: адрес в Москве, телефоны, электронная почта. Мы находимся по адресу: Дмитровское шоссе 71Б, Бизнес-центр 7ONE.",
};
---

<BaseLayout {...seoData}>
  <ContactsPage {socials} />
</BaseLayout>
