---
import BaseLayout from "#/app/layout/BaseLayout.astro";
import { builtPaths } from "#/app/paths";
import { getImageUrl } from "#/core/pocketbase";
import { getTypeWithCollections, TypeCollections, typeDescription, type TypeRecord } from "#/site/catalog";

// One page per type that PocketBase holds at build time. The type and its collections are
// rendered into the page; the browser refreshes them from PocketBase after the page loads.
export async function getStaticPaths() {
  const { types } = await builtPaths();
  // One read after another, not a burst of parallel requests from the build.
  const paths = [];
  for (const type of types) {
    const { category, collections } = await getTypeWithCollections(type.path);
    paths.push({ params: { type: type.path }, props: { record: { category, collections: collections.items } satisfies TypeRecord } });
  }
  return paths;
}

const { type = "" } = Astro.params;
const { record } = Astro.props as { record: TypeRecord };
const label = String(record.category.name || type);
const seoData = {
  title: `${label} - Коллекции тканей | Нортекс`,
  description: typeDescription(record.category),
  ogImage: getImageUrl(record.category) || undefined,
};
---

<BaseLayout {...seoData} canonical={`/textile/${type}/`}>
  <TypeCollections record={record} />
</BaseLayout>
