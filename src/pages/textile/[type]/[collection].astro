---
import BaseLayout from "#/app/layout/BaseLayout.astro";
import { CollectionPage, getCollection } from "#/catalog/textile";

const { type, collection: collectionPath } = Astro.params;

if (!type || !collectionPath) {
	return Astro.redirect("/textile");
}

// SSR - загружаем данные на лету
const collection = await getCollection(collectionPath);

const seoData = {
	title: `${collection.name} - Ткани коллекции | Нортекс`,
	description: collection.description || `Ткани из коллекции ${collection.name}`,
};
---

<BaseLayout {...seoData}>
	<CollectionPage collection={collection} />
</BaseLayout>
