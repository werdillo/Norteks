---
import BaseLayout from "#/app/layout/BaseLayout.astro";
import { BlogList, getBlogPosts } from "#/site/blog";

// The posts PocketBase holds at build: the list is in the HTML, the browser refreshes it.
const posts = await getBlogPosts();

const seoData = {
  title: "Блог о тканях и дизайне | Советы от экспертов Нортекс",
  description: "Полезные статьи о выборе тканей, уходе за текстилем, модных тенденциях в дизайне интерьера. Экспертные советы от компании Нортекс.",
};
---

<BaseLayout {...seoData}>
  <BlogList posts={posts} />
</BaseLayout>
