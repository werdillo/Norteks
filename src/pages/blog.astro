---
import BaseLayout from "#/app/layout/BaseLayout.astro";
import { BlogList, getBlogPostsPage } from "#/site/blog";

// The first page of posts PocketBase holds at build: it is in the HTML, the browser refreshes it and loads the next ones.
const { posts, hasMore } = await getBlogPostsPage(1);

const seoData = {
  title: "Блог о тканях и дизайне | Советы от экспертов Нортекс",
  description: "Полезные статьи о выборе тканей, уходе за текстилем, модных тенденциях в дизайне интерьера. Экспертные советы от компании Нортекс.",
};
---

<BaseLayout {...seoData}>
  <BlogList posts={posts} hasMore={hasMore} />
</BaseLayout>
