---
import BaseLayout from "#/app/layout/BaseLayout.astro";
import { HomePage } from "#/company/home";
import { TypesGrid, getTypes } from "#/catalog/textile";

const seoData = {
  title: "Нортекс - Оптовый поставщик декоративных тканей | Ткани для мебели и штор",
  description: "Компания Нортекс - ваш надежный партнер в мире декоративных тканей. Более 20 лет опыта, широкий ассортимент: велюр, замша, экокожа, рогожка. Работаем с дизайнерами и архитекторами.",
  keywords: "ткани оптом, декоративные ткани, мебельные ткани, шторные ткани, велюр, замша, экокожа, рогожка, дизайнерские ткани, Нортекс, поставщик тканей"
};

// SSR - загружаем данные на сервере
const categories = await getTypes();
---

<BaseLayout {...seoData}>
  <HomePage>
    <Fragment slot="catalog">
      <TypesGrid categories={categories} />
    </Fragment>
  </HomePage>
</BaseLayout>
