---
import BaseLayout from "#/app/layout/BaseLayout.astro";
import { TypesGrid } from "#/site/catalog";
import { Advantages } from "#/site/company";
import { HomePage } from "#/site/home";

const seoData = {
  title: "Нортекс - Оптовый поставщик декоративных тканей | Ткани для мебели и штор",
  description: "Компания Нортекс - ваш надежный партнер в мире декоративных тканей. Более 20 лет опыта, широкий ассортимент: велюр, замша, экокожа, рогожка. Работаем с дизайнерами и архитекторами.",
};
---

<BaseLayout {...seoData}>
  <HomePage>
    <Advantages slot="advantages" />
    <TypesGrid slot="catalog" heading="h2" />
  </HomePage>
</BaseLayout>
