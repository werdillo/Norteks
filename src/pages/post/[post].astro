---
import BaseLayout from "#/app/layout/BaseLayout.astro";
import { PostPage, getPostByPath } from "#/blog/posts";

const { post: postPath } = Astro.params;

if (!postPath) {
  return Astro.redirect("/blog");
}

// SSR - загружаем данные на лету
const post = await getPostByPath(postPath);

const seoData = {
  title: `${post.title} | Блог Нортекс`,
  description: post.description || post.title,
};
---

<BaseLayout {...seoData}>
  <PostPage post={post} />
</BaseLayout>
