---
import BaseLayout from "#/app/layout/BaseLayout.astro";
import { builtPaths } from "#/app/paths";
import { getPostForBuild, PostPage, postDescription, type BlogPost } from "#/site/blog";

// One page per post that PocketBase holds at build time, with the post's record in the HTML.
export async function getStaticPaths() {
  const { posts } = await builtPaths();
  // One request at a time: the build's parallel reads of PocketBase drop under load.
  const paths = [];
  for (const post of posts) paths.push({ params: { post: post.path }, props: { post: await getPostForBuild(post.path) } });
  return paths;
}

const { post } = Astro.props as { post: BlogPost };
const path = Astro.params.post ?? "";
const label = post.title || path;
const seoData = {
  title: `${label} | Блог Нортекс`,
  description: postDescription(post),
};
---

<BaseLayout {...seoData} canonical={`/post/${path}/`}>
  <PostPage post={post} />
</BaseLayout>
