---
import BaseLayout from "#/app/layout/BaseLayout.astro";
import { getTypes, TypesGrid } from "#/site/catalog";

const seoData = {
  title: "Коллекции декоративных тканей | Каталог тканей Нортекс",
  description: "Широкий выбор декоративных тканей: велюр, замша, микрофибра, экокожа, рогожка, шенилл, букле. Ткани для мебели и штор от поставщика с 20-летним опытом.",
};

const types = await getTypes();
---

<BaseLayout {...seoData}>
  <TypesGrid types={types} />
</BaseLayout>
