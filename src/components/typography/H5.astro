---
import "./typography.css";

// Heading 5: 22px bold, 20px up to 768px. Renders the tag given in `as`, so the look and the meaning can differ.
interface Props {
  as?: string;
  class?: string;
  [attribute: string]: unknown;
}

const { as: Tag = "h5", class: extra, ...rest } = Astro.props;
---

<Tag class:list={["text-h5", extra]} {...rest}><slot /></Tag>
