---
import "./typography.css";

// Heading 2: 42px bold, 36px up to 1024px. Renders the tag given in `as`, so the look and the meaning can differ.
interface Props {
  as?: string;
  class?: string;
  [attribute: string]: unknown;
}

const { as: Tag = "h2", class: extra, ...rest } = Astro.props;
---

<Tag class:list={["text-h2", extra]} {...rest}><slot /></Tag>
