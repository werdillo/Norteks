---
import "./typography.css";

// Heading 1: 48px bold, 40px up to 768px. Renders the tag given in `as`, so the look and the meaning can differ.
interface Props {
  as?: string;
  class?: string;
  [attribute: string]: unknown;
}

const { as: Tag = "h1", class: extra, ...rest } = Astro.props;
---

<Tag class:list={["text-h1", extra]} {...rest}><slot /></Tag>
