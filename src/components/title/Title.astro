---
interface Props {
  /** `xl` is the page title, `s` and `xs` are the smaller titles of lists and collections. */
  size?: "xl" | "s" | "xs";
}

const { size = "xl" } = Astro.props;

const sizes = {
  xl: "text-42 max-1024:text-36",
  s: "text-32",
  xs: "text-28",
};
---

<div class:list={["font-bold", sizes[size]]}>
  <slot />
</div>
