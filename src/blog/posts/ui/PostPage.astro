---
import type { RecordModel } from "pocketbase";
import { Container } from "#/components/container";
import { getImageUrl } from "#/core/pocketbase";

interface Props {
  post: RecordModel;
}

const { post } = Astro.props;
---

<img src={getImageUrl(post)} class="h-[500px] w-full object-cover max-768:h-[30vh]" alt={post.title} />
<Container>
  <div class="p-20 max-768:p-10">
    <div class="text-32 font-bold">{post.title}</div>
    <div class="text-18" set:html={post.content}></div>
  </div>
</Container>
