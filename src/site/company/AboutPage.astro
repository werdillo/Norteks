---
import { Image } from "astro:assets";
import { H1, P1, P2, P3 } from "#/components/typography";
import { PageColumn } from "#/components/page-column";
import interior1 from "./assets/images/img6.jpg";
import interior2 from "./assets/images/img5.jpg";
import { aboutFacts, aboutLead, aboutParagraphs } from "./about";

const picture = "block h-auto w-full elevation-image";
---

<PageColumn>
  <div class="box-border grid w-[96%] max-w-wide grid-cols-[1fr_1fr] items-start gap-48 py-40 max-1024:gap-32 max-768:grid-cols-[1fr] max-768:gap-24 max-768:py-24">
    <div class="flex flex-col">
      <H1 class="m-0 mb-8 text-heading max-768:text-h3">О компании</H1>
      <P1 class="m-0 text-muted">НОРТЕКС — оптовый поставщик декоративных тканей</P1>

      <!-- A few facts from the text below, as a quiet row under the heading. -->
      <ul class="m-0 mt-20 mb-24 flex list-none flex-wrap gap-x-24 gap-y-8 p-0 py-14 [border-top:1px_solid_var(--color-hairline)] [border-bottom:1px_solid_var(--color-hairline)]">
        {
          aboutFacts.map((fact) => (
            <li class="flex items-center gap-8">
              <span class="block h-6 w-6 shrink-0 rounded-[50%] bg-gold" aria-hidden="true" />
              <P3 as="span" class="uppercase tracking-[0.5px] text-copy">{fact}</P3>
            </li>
          ))
        }
      </ul>

      <P1 class="m-0 text-heading">{aboutLead}</P1>
      {aboutParagraphs.map((paragraph) => <P2 class="m-0 mt-16 text-copy">{paragraph}</P2>)}
    </div>

    <div class="grid gap-20 max-768:gap-12">
      <Image class={picture} src={interior1} alt="Интерьер с текстилем" />
      <Image class={picture} src={interior2} alt="Дизайн интерьера" />
    </div>
  </div>
</PageColumn>
