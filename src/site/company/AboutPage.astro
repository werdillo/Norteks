---
import { Image } from "astro:assets";
import { Container } from "#/components/container";
import { H1, H5, P1, P2 } from "#/components/typography";
import interior1 from "./assets/images/img6.jpg";
import interior2 from "./assets/images/img5.jpg";
import { aboutLead, aboutParagraphs } from "./about";

const picture = "h-auto w-full elevation-image";
---

<div class="mx-10 bg-surface">
  <H1 class="mb-16 text-gold">Нортекс</H1>
  <H5 as="p" class="text-muted">Оптовый поставщик декоративных тканей</H5>
  <Container width="min">
    <div class="grid grid-cols-[1fr_1fr] gap-40 [align-items:start] max-768:grid-cols-[1fr]">
      <div class="flex flex-col gap-24 max-768:gap-14">
        <P1 class="my-4 text-heading">{aboutLead}</P1>
        {aboutParagraphs.map((paragraph) => <P2 class="text-copy">{paragraph}</P2>)}
      </div>

      <div class="grid gap-20">
        <Image class={picture} src={interior1} alt="Интерьер с текстилем" />
        <Image class={picture} src={interior2} alt="Дизайн интерьера" />
      </div>
    </div>
  </Container>
</div>
