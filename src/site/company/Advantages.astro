---
import { Container } from "#/components/container";
import FeatureCard from "./FeatureCard.astro";
import { features } from "./advantages";
---

<Container>
  <section class="py-80 max-768:py-40" aria-label="Преимущества">
    <div
      class="grid w-full grid-cols-[repeat(auto-fit,minmax(430px,1fr))] justify-items-center gap-20 max-768:grid-cols-[repeat(auto-fit,minmax(250px,1fr))]"
    >
      {features.map((feature) => <FeatureCard {...feature} />)}
    </div>
  </section>
</Container>
