---
import { Image } from "astro:assets";
import { Card } from "#/components/card";
import { Container } from "#/components/container";
import { H4, H5, H6, P2 } from "#/components/typography";
import { intro, pictures, sections, tips, tipsTitle } from "./data";
---

<div class="mt-20 mb-40 flex w-full justify-between gap-5">
  {pictures.map((src) => <Image src={src} alt="" class="max-h-[18vw] w-auto elevation-image-small" />)}
</div>

<Container width="offset">
  <div class="mb-20 flex flex-col gap-40">
    <Card variant="panel">
      <H4 as="h1" class="mb-16 pb-10 text-heading">{intro.title}</H4>
      <div class="flex flex-col gap-15">
        {intro.paragraphs.map((text) => <P2 class="my-[5px] text-copy">{text}</P2>)}
      </div>
    </Card>

    <Card variant="panel">
      <H5 as="h2" class="mb-20 text-copy">{tipsTitle}</H5>
      <div class="mt-20 grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-30 max-768:grid-cols-[1fr]">
        {
          tips.map((tip) => (
            <div>
              <H6 as="h3" class="mt-0 pl-24 text-muted">{tip.title}</H6>
              <div class="[border-left:2px_solid_var(--color-rule)] pl-20">
                {tip.items.map((text) => <P2>{text}</P2>)}
              </div>
            </div>
          ))
        }
      </div>
    </Card>

    {
      sections.map((section) => (
        <Card variant="panel">
          <H5 as="h2" class="mb-20 text-copy">{section.title}</H5>
          <div class="flex flex-col gap-15">
            {section.paragraphs.map((text) => <P2 class="my-[5px] text-copy">{text}</P2>)}
          </div>
        </Card>
      ))
    }
  </div>
</Container>
