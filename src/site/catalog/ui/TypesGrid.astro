---
import { Container } from "#/components/container";
import { ImageTile } from "#/components/image-tile";
import { H4, P2 } from "#/components/typography";
import { Skeleton } from "#/components/skeleton";

interface Props {
  /** The heading's tag: h1 on the types page, h2 under the home page's hero. */
  heading?: "h1" | "h2";
}

const { heading = "h1" } = Astro.props;

const grid = "mt-20 grid w-full grid-cols-[1fr_1fr_1fr_1fr] gap-20 max-1024:grid-cols-[1fr_1fr] max-1024:gap-10";
---

<Container>
  <H4 as={heading} class="m-0">Широкий выбор тканей</H4>
  <div class="w-full" data-types aria-busy="true">
    <div data-status="loading">
      <span class="sr-only">Загрузка…</span>
      <div class={grid}>
        {Array.from({ length: 8 }, () => <Skeleton variant="tile" ratio="4/3" />)}
      </div>
    </div>
    <P2 as="div" class="mt-20 text-muted" data-status="error" hidden>Не удалось загрузить данные. Попробуйте позже.</P2>
    <div class={grid} data-status="ready" hidden></div>
    <template data-tile>
      <ImageTile href="#" src="" alt="" label="" ratio="4/3" />
    </template>
  </div>
</Container>

<script>
  import { getImageUrl } from "#/core/pocketbase";
  import { setStatus } from "#/core/dom";
  import { tileFrom } from "#/components/image-tile";
  import { getTypes } from "../api";
  import { typeHref } from "../links";

  const root = document.querySelector<HTMLElement>("[data-types]");
  if (root) {
    const grid = root.querySelector<HTMLElement>('[data-status="ready"]')!;
    const template = root.querySelector<HTMLTemplateElement>("template[data-tile]")!;
    getTypes()
      .then(async (types) => {
        const hrefs = await Promise.all(types.map((type) => typeHref(type.path)));
        grid.replaceChildren(
          ...types.map((type, index) =>
            tileFrom(template, {
              href: hrefs[index],
              src: getImageUrl(type),
              alt: type.name,
              label: type.name,
            }),
          ),
        );
        setStatus(root, "ready");
      })
      .catch((error) => {
        console.error(error);
        setStatus(root, "error");
      });
  }
</script>
