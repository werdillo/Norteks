---
import { P2, P3 } from "#/components/typography";
import { Skeleton } from "#/components/skeleton";

// A fixed width: focus changes only the border and the ring, so nothing in the header moves.
const input =
  "text-p2 max-768:text-p3 box-border w-[180px] max-1200:w-[160px] max-768:w-[136px] rounded-pill border border-solid border-line bg-field py-7 pr-12 pl-34 text-on-dark [transition:border-color_0.2s,box-shadow_0.2s] placeholder:text-placeholder hover:border-line-strong focus:border-highlight focus:elevation-focus focus:[outline:none]";
const panel =
  "absolute top-[calc(100%_+_6px)] right-0 z-[var(--z-overlay)] max-h-[320px] max-768:max-h-[250px] w-[300px] max-768:w-[min(260px,calc(100vw_-_20px))] overflow-y-auto rounded-panel border border-solid border-line bg-chrome elevation-menu [&::-webkit-scrollbar]:w-[6px] [&::-webkit-scrollbar-track]:bg-track [&::-webkit-scrollbar-thumb]:rounded-[3px] [&::-webkit-scrollbar-thumb]:bg-line [&::-webkit-scrollbar-thumb:hover]:bg-line-strong";
const message = "text-p2 cursor-default px-12 py-10";
const item =
  "block cursor-pointer px-12 py-10 [border-bottom:1px_solid_var(--color-divider)] [transition:background_0.2s] last:[border-bottom:none] hover:bg-field";
---

<!-- The header search: type two letters, results after a short pause. Plain markup and a script; the script reads the data box's api.ts. -->
<div class="group relative flex shrink-0 items-center" data-search role="search">
  <svg
    class="pointer-events-none absolute top-1/2 left-12 z-[1] h-16 w-16 [transform:translateY(-50%)] text-placeholder [transition:color_0.2s] group-focus-within:text-highlight"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2" />
    <path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
  <input
    type="text"
    class={input}
    placeholder="Поиск тканей"
    aria-label="Поиск тканей"
    autocomplete="off"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls="search-results"
    data-search-input
  />
  <div id="search-results" class={panel} data-search-panel aria-busy="false" hidden>
    <div class="px-12 py-10" data-status="loading" hidden>
      <span class="sr-only">Загрузка…</span>
      {[0, 1, 2].map(() => (
        <div class="flex items-center gap-10 py-10 [border-bottom:1px_solid_var(--color-divider)] last:[border-bottom:none]">
          <Skeleton variant="block" dark class="h-40 w-40 shrink-0 rounded-field" />
          <div class="min-w-0 flex-1">
            <P3 as="div" class="mb-2"><Skeleton variant="text" dark width="30%" /></P3>
            <P3 as="div"><Skeleton variant="text" dark width="60%" /></P3>
          </div>
        </div>
      ))}
    </div>
    <P2 as="div" class={message} data-status="empty" hidden>Ничего не найдено</P2>
    <ul class="m-0 list-none p-0" data-status="ready" hidden data-search-list></ul>
  </div>
  <template data-search-item>
    <li>
      <a class={item} data-field="link">
        <div class="flex items-center gap-10">
          <img data-field="image" class="h-40 w-40 shrink-0 rounded-field object-cover" alt="" loading="lazy" />
          <div class="min-w-0 flex-1">
            <P3 as="span" class="mb-2 block tracking-[0.5px] text-placeholder uppercase" data-field="kind"></P3>
            <P3 as="div" class="overflow-hidden text-ellipsis whitespace-nowrap text-on-dark" data-field="name"></P3>
          </div>
        </div>
      </a>
    </li>
  </template>
</div>

<script>
  import { getImageUrl } from "#/core/pocketbase";
  import { field, fromTemplate, setStatus } from "#/core/dom";
  import { searchCatalog } from "../api";
  import type { SearchResult } from "../types";

  const DEBOUNCE_MS = 300;

  for (const box of document.querySelectorAll<HTMLElement>("[data-search]")) {
    const input = box.querySelector<HTMLInputElement>("[data-search-input]")!;
    const panel = box.querySelector<HTMLElement>("[data-search-panel]")!;
    const list = box.querySelector<HTMLElement>("[data-search-list]")!;
    const template = box.querySelector<HTMLTemplateElement>("[data-search-item]")!;
    let timer: number | undefined;
    let latest = 0; // only the answer to the newest query is shown

    const open = (on: boolean) => {
      panel.hidden = !on;
      input.setAttribute("aria-expanded", String(on));
    };

    const show = (results: SearchResult[]) => {
      list.replaceChildren(
        ...results.map((result) => {
          const fragment = fromTemplate(template);
          const link = field<HTMLAnchorElement>(fragment, "link");
          link.href = result.url;
          if (result.url === "#") link.addEventListener("click", (event) => event.preventDefault());
          field(fragment, "kind").textContent = result.type === "category" ? "Категория" : "Коллекция";
          field(fragment, "name").textContent = result.name;
          const image = field<HTMLImageElement>(fragment, "image");
          if (result.image) {
            image.src = getImageUrl(result);
            image.alt = result.name;
          } else {
            image.remove();
          }
          return fragment;
        }),
      );
      setStatus(panel, results.length ? "ready" : "empty");
    };

    const run = async (query: string) => {
      const id = ++latest;
      setStatus(panel, "loading");
      open(true);
      let results: SearchResult[] = [];
      try {
        results = await searchCatalog(query);
      } catch (error) {
        console.error("Search error:", error);
      }
      if (id === latest) show(results);
    };

    input.addEventListener("input", () => {
      const query = input.value.trim();
      clearTimeout(timer);
      if (query.length < 2) {
        latest++;
        open(false);
        return;
      }
      timer = window.setTimeout(() => run(query), DEBOUNCE_MS);
    });

    // Escape closes the results from anywhere in the box and returns the focus to the input.
    box.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || panel.hidden) return;
      open(false);
      input.focus();
    });

    document.addEventListener("click", (event) => {
      if (!box.contains(event.target as Node)) open(false);
    });
  }
</script>
