---
import { H1, P1, P2, P3 } from "#/components/typography";
import { PageColumn } from "#/components/page-column";
import { address, emails, phones } from "./data";

// One block of the contacts: an icon, a small label, then the values under it.
const block = "flex items-start gap-14 py-20 [border-top:1px_solid_var(--color-hairline)] first-of-type:[border-top:none]";
const icon = "flex h-36 w-36 shrink-0 items-center justify-center rounded-[50%] bg-note";
const label = "m-0 mb-6 uppercase tracking-[1px] text-muted";
const link = "text-heading [transition:color_0.2s] hover:text-gold";
---

<PageColumn>
  <div class="box-border grid w-[96%] max-w-wide grid-cols-[1fr_1fr] items-start gap-48 py-40 max-1024:gap-32 max-768:grid-cols-[1fr] max-768:gap-24 max-768:py-24">
    <div class="flex flex-col">
      <H1 class="m-0 mb-8 text-heading max-768:text-h3">Контакты</H1>
      <P1 class="m-0 mb-16 text-muted">ООО «Нортекс» — оптовый поставщик декоративных тканей</P1>

      <div class={block}>
        <span class={icon} aria-hidden="true"><span class="i-tabler-map-pin block h-18 w-18 text-gold" /></span>
        <div class="flex flex-col">
          <P3 as="div" class={label}>Адрес</P3>
          <P1 class="m-0 text-heading">{address.full}</P1>
          <P2 class="m-0 mt-6 flex items-center gap-6 text-copy">
            <span class="i-tabler-train block h-16 w-16 shrink-0 text-gold" aria-hidden="true" />
            Метро «{address.metro}»
          </P2>
          <P2 as="a" href={address.routeUrl} target="_blank" rel="noopener" class="mt-10 w-fit text-gold [transition:opacity_0.2s] hover:opacity-75">
            Построить маршрут →
          </P2>
        </div>
      </div>

      <div class={block}>
        <span class={icon} aria-hidden="true"><span class="i-tabler-phone block h-18 w-18 text-gold" /></span>
        <div class="flex flex-col gap-4">
          <P3 as="div" class={label}>Телефоны</P3>
          {phones.map((item) => <P1 as="a" class={`${link} w-fit`} href={`tel:${item.number}`}>{item.display}</P1>)}
        </div>
      </div>

      <div class={block}>
        <span class={icon} aria-hidden="true"><span class="i-tabler-mail block h-18 w-18 text-gold" /></span>
        <div class="flex flex-col gap-4">
          <P3 as="div" class={label}>Электронная почта</P3>
          {emails.map((item) => <P1 as="a" class={`${link} w-fit break-all`} href={`mailto:${item}`}>{item}</P1>)}
        </div>
      </div>
    </div>

    <div class="h-[450px] w-full overflow-hidden rounded-card [border:1px_solid_var(--color-frame)] max-768:h-[320px]">
      <iframe
        src={address.mapUrl}
        title="Нортекс на карте"
        width="100%"
        height="100%"
        loading="lazy"
        allowfullscreen="true"
        class="block h-full w-full [border:0]"></iframe>
    </div>
  </div>
</PageColumn>
