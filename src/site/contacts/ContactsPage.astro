---
import { Card } from "#/components/card";
import { Container } from "#/components/container";
import { H1, H4, H6, P1, P2 } from "#/components/typography";
import { address, emails, page, phones } from "./data";
import { PageColumn } from "#/components/page-column";

interface Props {
  /** The messenger and social accounts to link, as the page passes them in (the header and the footer read the same list). */
  socials?: { href: string; icon: string; alt: string }[];
}

const { socials = [] } = Astro.props;

const section = "py-40 max-768:py-24";
const iconCircle =
  "flex h-48 w-48 shrink-0 items-center justify-center rounded-[50%] bg-note";
const icon = "block h-24 w-24 text-gold";
const link = "text-heading [transition:color_0.2s] hover:text-gold";
const chip =
  "inline-flex h-40 items-center gap-8 rounded-pill px-16 [border:1px_solid_var(--color-hairline)] bg-note text-heading [transition:color_0.2s,border-color_0.2s] hover:text-gold hover:[border-color:var(--color-gold)]";
const outlineButton =
  "inline-flex h-48 w-fit items-center gap-8 rounded-pill px-24 [border:2px_solid_var(--color-heading)] text-heading [transition:200ms] hover:bg-chrome hover:text-on-dark max-768:h-44";
---
<PageColumn>
<Container>
  <section class="flex flex-col gap-16 pt-40 max-768:pt-24">
    <H1 class="m-0 text-heading">{page.heading}</H1>
    <P1 class="m-0 max-w-[800px] text-copy">{page.lead}</P1>
  </section>
</Container>

<Container>
  <section class={section} aria-label={page.heading}>
    <div class="grid grid-cols-4 gap-20 max-1200:grid-cols-2 max-550:grid-cols-1 max-768:gap-12">
      <!-- The address, the metro station and the route to the company. -->
      <Card variant="raised" class="box-border flex flex-col gap-16">
        <span class={iconCircle} aria-hidden="true">
          <span class:list={["i-tabler-map-pin", icon]} />
        </span>
        <H6 as="h2" class="m-0 text-heading">{page.address}</H6>
        <P2 class="m-0 text-copy">{address.full}</P2>
        <P2 class="m-0 flex items-center gap-8 text-muted">
          <span class="i-tabler-train block h-18 w-18 shrink-0 text-gold" aria-hidden="true" />
          {page.metroLabel}: {address.metro}
        </P2>
        <a href={address.routeUrl} target="_blank" rel="noopener" class={`${outlineButton} mt-auto`}>
          <span class="i-tabler-route block h-18 w-18 shrink-0" aria-hidden="true" />
          <P1 as="span">{page.route}</P1>
        </a>
      </Card>

      <Card variant="raised" class="box-border flex flex-col gap-16">
        <span class={iconCircle} aria-hidden="true">
          <span class:list={["i-tabler-phone", icon]} />
        </span>
        <H6 as="h2" class="m-0 text-heading">{page.phones}</H6>
        <div class="flex flex-col gap-8">
          {phones.map((item) => (
            <P1 as="a" class={`${link} m-0 w-fit`} href={`tel:${item.number}`}>{item.display}</P1>
          ))}
        </div>
      </Card>

      <Card variant="raised" class="box-border flex flex-col gap-16">
        <span class={iconCircle} aria-hidden="true">
          <span class:list={["i-tabler-mail", icon]} />
        </span>
        <H6 as="h2" class="m-0 text-heading">{page.mail}</H6>
        <div class="flex flex-col gap-8">
          {emails.map((item) => (
            <P1 as="a" class={`${link} m-0 w-fit break-all`} href={`mailto:${item}`}>{item}</P1>
          ))}
        </div>
      </Card>

      {
        socials.length > 0 && (
          <Card variant="raised" class="box-border flex flex-col gap-16">
            <span class={iconCircle} aria-hidden="true">
              <span class:list={["i-tabler-message-circle", icon]} />
            </span>
            <H6 as="h2" class="m-0 text-heading">{page.social}</H6>
            <ul class="m-0 flex list-none flex-wrap gap-8 p-0">
              {socials.map((social) => (
                <li>
                  <a href={social.href} target="_blank" rel="noopener" class={chip}>
                    <span class:list={[social.icon, "block h-18 w-18 shrink-0"]} aria-hidden="true" />
                    <P2 as="span">{social.alt}</P2>
                  </a>
                </li>
              ))}
            </ul>
          </Card>
        )
      }
    </div>
  </section>
</Container>

<!-- The map, in a rounded frame: a fixed height, so the frame keeps its shape at every width. -->
<Container>
  <section class={section}>
    <H4 as="h2" class="m-0 mb-24 text-heading max-768:mb-16">{page.mapHeading}</H4>
    <div class="h-[420px] w-full overflow-hidden rounded-card [border:1px_solid_var(--color-frame)] elevation-card max-768:h-[300px]">
      <iframe
        src={address.mapUrl}
        title={page.mapTitle}
        width="100%"
        height="100%"
        loading="lazy"
        allowfullscreen="true"
        class="block h-full w-full [border:0]"></iframe>
    </div>
  </section>
</Container>
</PageColumn>
