---
import { H5, P1 } from "#/components/typography";
import { address, emails, phones } from "./data";

const row = "flex items-start gap-16 mb-16 max-768:flex-col";
const link = "text-heading hover:text-gold";
---

<div class="mx-auto my-32 grid max-w-narrow grid-cols-[1fr_1fr] gap-32 px-16 max-768:grid-cols-[1fr]">
  <div class="p-16">
    <H5 as="h1" class="mt-0 text-heading">НОРТЕКС</H5>

    <div class={row}>
      <span class="i-tabler-map-pin h-24 w-24 shrink-0" aria-hidden="true" />
      <P1>
        {address.full}<br />
        Метро: Верхние Лихоборы<br />
      </P1>
    </div>

    <div class={row}>
      <span class="i-tabler-phone h-24 w-24 shrink-0" aria-hidden="true" />
      {phones.map((item) => (
        <P1 as="a" class={link} href={`tel:${item.number}`}>{item.display}</P1>
      ))}
    </div>

    <div class={row}>
      <span class="i-tabler-mail h-24 w-24 shrink-0" aria-hidden="true" />
      {emails.map((address) => (
        <P1 as="a" class={link} href={`mailto:${address}`}>{address}</P1>
      ))}
    </div>
  </div>

  <div class="h-[450px] w-full">
    <iframe
      src={address.mapUrl}
      title="Нортекс на карте"
      width="100%"
      height="450"
      allowfullscreen="true"
      class="border border-solid border-frame"></iframe>
  </div>
</div>
